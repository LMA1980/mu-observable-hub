[Unit]
Description=Mu-Observable Hub Telemetry, Analytics & MCP Daemon
Documentation=https://github.com/LMA1980/mu-observable-hub
After=network.target

[Service]
Type=simple
User=mu-observable-hub
Group=mu-observable-hub
WorkingDirectory=/var/lib/mu-observable-hub
EnvironmentFile=/etc/mu-observable-hub/hub.env
ExecStart=/usr/local/bin/mu-observable-hub --serve
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

ReadWritePaths=/var/lib/mu-observable-hub
ReadOnlyPaths=/etc/mu-observable-hub
InaccessiblePaths=/etc/shadow /root /home

[Install]
WantedBy=multi-user.target
