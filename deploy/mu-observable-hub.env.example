# ==============================================================================
# Mu-Observable Hub Daemon Environment Configuration
# Path: /etc/mu-observable-hub/hub.env (Permissions: 0600 mu-observable-hub:mu-observable-hub)
# ==============================================================================

# Node identifier and serve-mode toggle
MU_OBSERVABLE_HUB_NODE_ID=node-a
MU_OBSERVABLE_HUB_SERVE=true

# Hot DuckDB & Cold Zstd Parquet Storage Paths
MU_OBSERVABLE_HUB_DB_PATH=/var/lib/mu-observable-hub/hot.duckdb
MU_OBSERVABLE_HUB_PARQUET_ROOT=/var/lib/mu-observable-hub/parquet

# DuckDB Resource Bounds & Checkpoint Cadence
MU_OBSERVABLE_HUB_DUCKDB_MEMORY_LIMIT=1GB
MU_OBSERVABLE_HUB_DUCKDB_THREADS=2
MU_OBSERVABLE_HUB_FLUSH_INTERVAL_SECS=30

# FIFO Disk-Space & Store Footprint Limits (bytes)
MU_OBSERVABLE_HUB_MAX_STORE_BYTES=10737418240
MU_OBSERVABLE_HUB_MIN_FREE_DISK_BYTES=2147483648

# Optional S3/Garage Cold Shard Tier
# MU_OBSERVABLE_HUB_S3_ENDPOINT=http://192.0.2.10:3900
# MU_OBSERVABLE_HUB_S3_BUCKET=mu-observable-cold

# Network Listeners (mTLS ingestion + HTTP/SSE MCP & Ingress API)
MU_OBSERVABLE_HUB_LISTEN_ADDR=0.0.0.0:9443
MU_OBSERVABLE_HUB_MCP_HTTP_ADDR=127.0.0.1:9480

# step-ca Mutual TLS Certificates & SAN Attribution Policy
MU_OBSERVABLE_HUB_CA_CERT=/etc/mu-observable-hub/tls/ca.crt
MU_OBSERVABLE_HUB_SERVER_CERT=/etc/mu-observable-hub/tls/server.crt
MU_OBSERVABLE_HUB_SERVER_KEY=/etc/mu-observable-hub/tls/server.key
MU_OBSERVABLE_HUB_SAN_POLICY=override
MU_OBSERVABLE_HUB_ALLOWED_DNS_SUFFIX=cluster.internal
# MU_OBSERVABLE_HUB_TLS_CA=/etc/mu-observable-hub/tls/ca.crt

# Edge Proxy Auth (mu-auth), Operator Tokens & Anonymous Folio Policy
# MU_OBSERVABLE_HUB_PROXY_SECRET_FILE=/etc/mu-observable-hub/proxy.secret
# MU_OBSERVABLE_HUB_OPERATOR_TOKEN_FILE=/etc/mu-observable-hub/operator.token
# MU_OBSERVABLE_HUB_INGRESS_ADMIN_TOKEN_FILE=/etc/mu-observable-hub/ingress_admin.token
# MU_OBSERVABLE_HUB_BEARER_TOKEN_FILE=/etc/mu-observable-hub/bearer.token
# MU_OBSERVABLE_HUB_OPERATOR_USERS=operator-user
MU_OBSERVABLE_HUB_ANONYMOUS_FOLIOS=folio:system:status
# MU_OBSERVABLE_HUB_ANONYMOUS_LOCKDOWN=false

# Upstream Service Routes & AI Diagnostics
MU_CI_CONTROLLER_URL=http://127.0.0.1:8000
# MU_OBSERVABLE_HUB_UPSTREAM_PROBE_TIMEOUT_MS=2000
# JERO_MANAGER_URL=http://127.0.0.1:8080

# Privacy Redaction & Non-Destructive Monitoring Exclusions
# MU_OBSERVABLE_HUB_HOSTNAME_ALIASES=internal-node-1:node-a,internal-node-2:node-b
# MU_OBSERVABLE_HUB_EXCLUDED_REPOS=
# MU_OBSERVABLE_HUB_RETIRED_SERVICES=
# MU_OBSERVABLE_HUB_MONITORING_SINCE_UNIX_NANO=

# Logging level
RUST_LOG=info,mu_observable_hub=info
